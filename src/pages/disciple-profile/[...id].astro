---
import type { DiscipleProfileEntry } from "@/types";
import GroupLayout from "@components/discipleProfile/GroupLayout.astro";
import EntryLayout from "@components/discipleProfile/EntryLayout.astro";
import { getEntries, getEntriesInGroup } from "@lib/contentParser";
import { sortByTitle } from "@lib/sortFunctions";
import { getEntry } from "astro:content";

export async function getStaticPaths() {
  const entries = (await getEntries("discipleProfile", sortByTitle)) as DiscipleProfileEntry[];

  return entries.map((entry) => {
    const segments = entry.id.replace("/-index", "").split("/");

    if (segments.length === 1) {
      return {
        params: { id: segments[0] },
        props: { entry, isGroup: true },
      };
    }
    return {
      params: { id: entry.id },
      props: { entry, isGroup: false },
    };
  });
}

const { entry, isGroup } = Astro.props;
const groupSlug = entry.id.replace("/-index", "");

const groupEntries = isGroup
  ? ((await getEntriesInGroup("discipleProfile", groupSlug, sortByTitle)) as DiscipleProfileEntry[])
  : [];

// Leaf pages link back to their point (the first path segment).
const pointSlug = entry.id.split("/")[0];
const pointEntry = !isGroup
  ? ((await getEntry("discipleProfile", `${pointSlug}/-index`)) as DiscipleProfileEntry)
  : undefined;
---

{
  isGroup ? (
    <GroupLayout point={entry} entries={groupEntries} />
  ) : (
    <EntryLayout entry={entry} pointEntry={pointEntry} />
  )
}
